# Pick ONE (or none — falls back to a built-in mock).
#
# Provider precedence: ANTHROPIC_API_KEY > GROQ_API_KEY > mock.

# Groq — FREE tier, no credit card. Get a key at https://console.groq.com/keys
# Uses llama-3.3-70b-versatile by default. Supports tool calling.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic — paid. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

PORT=8787
