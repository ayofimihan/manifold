{
  "name": "manifold",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build",
    "typecheck": "npm --workspace client run typecheck && npm --workspace server run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
